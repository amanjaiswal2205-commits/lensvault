# Django
DJANGO_SECRET_KEY=django-insecure-change-me-to-a-secure-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Local development database toggle
USE_SQLITE=True

# PostgreSQL
DB_NAME=lensvault
DB_USER=lensvault
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@lensvault.com
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Application
SITE_NAME=LensVault
